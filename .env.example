# PRAMAN — environment variables template
# Copy to .env and fill in values. NEVER commit .env.
# Testnet keys are throwaway EOAs. Mainnet: hardware wallet / Safe multisig ONLY.
# See architecture.md §7 for full variable list.

# ── RPC endpoints ──────────────────────────────────────────────────────────────
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org        # or Alchemy/Infura endpoint
BASE_RPC_URL=https://mainnet.base.org                # mainnet: requires APPROVED MAINNET

# ── Signing keys (TESTNET ONLY — throwaway EOA) ───────────────────────────────
# Generate with: cast wallet new
# Never reuse for mainnet. Never commit.
DEPLOYER_PRIVATE_KEY=0xYOUR_TESTNET_DEPLOYER_KEY_HERE
ATTESTER_PRIVATE_KEY=0xYOUR_TESTNET_ATTESTER_KEY_HERE
CANARY_ISSUER_PRIVATE_KEY=0xYOUR_TESTNET_CANARY_ISSUER_KEY_HERE

# ── Block explorer (optional, for `forge verify-contract`) ────────────────────
BASESCAN_API_KEY=YOUR_BASESCAN_API_KEY_HERE

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/pramana

# ── Chain / indexer config ────────────────────────────────────────────────────
CHAIN_ID=84532                           # 84532 = Base Sepolia; 8453 = Base mainnet
START_BLOCK=0                            # block to start indexing from
EAS_ADDRESS=0x4200000000000000000000000000000000000021
SCHEMA_REGISTRY_ADDRESS=0x4200000000000000000000000000000000000020

# ── Evidence storage ──────────────────────────────────────────────────────────
EVIDENCE_BASE_URL=https://your-evidence-host.example.com/evidence
